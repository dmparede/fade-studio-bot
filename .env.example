# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456789:replace-with-your-bot-token

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-key

# Optional: Gemini model to use (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Telegram chat ID that receives new bookings and human-support requests
# (your own user ID, or a staff group ID). Leave empty to disable.
ADMIN_CHAT_ID=
